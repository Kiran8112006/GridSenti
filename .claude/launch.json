{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gridsenti2-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "gridsenti2-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--app-dir", "backend", "--port", "8000"],
      "port": 8000,
      "url": "http://localhost:8000"
    }
  ]
}
